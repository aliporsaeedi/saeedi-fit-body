{
  "name": "saeedi-fit-body-design-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "account_id": "7eda224d6c9b5361506b0572f10ca8b3",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "vars": {
    "RELEASE": "design-review-v4",
    "DESIGN_PREVIEW": "true",
    "GAS_URL": "https://script.google.com/macros/s/AKfycbzO_LMU-DubcWtLc2ediWJJVO5lAHwPBQPoV0LzGq9MOJ8g8pYgviCHkDy2LwbVyxNs/exec"
  },
  "d1_databases": [
    {
      "binding": "REQUESTS_DB",
      "database_name": "saeedi-fit-body-requests",
      "database_id": "bce5701b-1b6d-41fd-a222-2b13c79cede5"
    }
  ]
}
